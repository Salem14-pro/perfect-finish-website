# Perfect Finish — Environment Variables
# Copy this to .env and fill in your values

PORT=3000

# SMTP Configuration (for email notifications)
# Gmail example: use an App Password, not your main password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Where to send admin notifications
ADMIN_EMAIL=your-email@gmail.com

# API key for the admin endpoints (choose any secure random string)
ADMIN_API_KEY=change-me-to-a-secure-random-string
